<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:padding="20dp"
    android:layout_margin="40dp"
    android:elevation="3dp"
    android:background="@drawable/inset_popup"
    >

    <ImageView
        android:id="@+id/done_success"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/success_popup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/thank_you_buddy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/instrument_sans_semi_bold"
        android:text="Password Reset"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/done_success" />


    <TextView
        android:id="@+id/mRegistration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/instrument_sans_regular"
        android:text="Use the new password during logging into get access your account"
        android:textColor="@color/gray"
        android:textSize="12sp"
        android:gravity="center"
        android:lineHeight="16dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thank_you_buddy" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Okay"
        android:textSize="16sp"
        android:paddingHorizontal="25dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_round_25"
        android:textColor="@color/white"
        android:backgroundTint="#c6a367"
        android:fontFamily="@font/instrument_sans_medium"
        app:layout_constraintTop_toBottomOf="@+id/mRegistration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/okay"/>

</androidx.constraintlayout.widget.ConstraintLayout>